{
  "workdir": "/workdir",
  "base_image": "ubuntu:24.04",
  "setup_commands": [
    "apt-get update \u0026\u0026 apt-get install -y curl ca-certificates python3 python3-yaml",
    "ARCH=$(dpkg --print-architecture) \u0026\u0026 curl -fsSL -o /tmp/q.deb https://github.com/quarto-dev/quarto-cli/releases/download/v1.6.43/quarto-1.6.43-linux-${ARCH}.deb \u0026\u0026 dpkg -i /tmp/q.deb \u0026\u0026 rm /tmp/q.deb"
  ]
}